{
  "name": "rcs-backend",
  "version": "2.0.0",
  "description": "RCS Backend - MS SQL Server Express - www.rcs.com Edition",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node seed.js",
    "build": "cd ../frontend && npm run build",
    "run-app": "npm run build && npm start",
    "frontend": "cross-env HOST=www.rcs.com npm start --prefix ../frontend",
    "both": "concurrently \"npm run dev\" \"npm run frontend\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "sequelize": "^6.35.2",
    "sqlite3": "^6.0.1",
    "tedious": "^18.2.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "nodemon": "^3.0.2"
  }
}
